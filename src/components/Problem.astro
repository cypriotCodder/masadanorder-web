---
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="problem" aria-labelledby="problem-title">
  <div class="container inner">
    <h2 id="problem-title" class="visually-hidden">{t.problem.title}</h2>
    <p class="pain">{t.problem.text}</p>
    <p class="fix"><strong>{t.problem.solutionLead}</strong> {t.problem.solution}</p>
  </div>
</section>

<style>
  .problem {
    padding-block: 3rem;
    background: var(--color-text);
    color: var(--color-bg);
  }
  .inner {
    display: grid;
    gap: 1.25rem;
    max-width: 52rem;
  }
  p {
    margin: 0;
    line-height: 1.4;
  }
  .pain {
    font-size: clamp(1.125rem, 3vw, 1.375rem);
    color: var(--color-neutral-200);
  }
  .fix {
    font-size: clamp(1.375rem, 4vw, 1.875rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .fix strong {
    color: var(--color-accent);
  }
  @media (min-width: 768px) {
    .problem {
      padding-block: 4.5rem;
    }
  }
</style>
