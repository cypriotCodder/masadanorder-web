---
import Logo from './Logo.astro';
import LangToggle from './LangToggle.astro';
import { homePath, sections, type Dictionary, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  t: Dictionary;
}

const { lang, t } = Astro.props;
const home = homePath(lang);
const links = [
  { id: sections.howItWorks, label: t.nav.howItWorks },
  { id: sections.features, label: t.nav.features },
  { id: sections.faq, label: t.nav.faq },
];
---

<header class="header">
  <div class="container bar">
    <Logo href={home} />
    <nav class="sections" aria-label={t.nav.label}>
      {links.map((l) => <a href={`${home}#${l.id}`}>{l.label}</a>)}
    </nav>
    <div class="end">
      <LangToggle lang={lang} label={t.nav.languageLabel} />
      <a class="btn btn-primary cta" href={`${home}#${sections.contact}`}>{t.cta.requestDemo}</a>
    </div>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-divider);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: 1.5rem;
    padding-block: 0.75rem;
  }
  .sections {
    display: flex;
    gap: 1.25rem;
    /* Mobile: second row, scrolls on its own instead of widening the page. */
    order: 3;
    flex-basis: 100%;
    overflow-x: auto;
    white-space: nowrap;
    font-size: 0.9375rem;
  }
  .sections a {
    color: var(--color-text);
    text-decoration: none;
    padding-block: 0.5rem;
  }
  .sections a:hover {
    color: var(--color-accent-700);
  }
  .end {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  /* The sticky bottom bar carries the CTA on mobile. */
  .cta {
    display: none;
  }
  @media (min-width: 768px) {
    .bar {
      flex-wrap: nowrap;
    }
    .sections {
      order: 0;
      flex-basis: auto;
      margin-inline: auto;
      overflow: visible;
    }
    .cta {
      display: inline-flex;
    }
  }
</style>
