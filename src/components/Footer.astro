---
import Logo from './Logo.astro';
import LangToggle from './LangToggle.astro';
import { homePath, privacyPath, type Dictionary, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  t: Dictionary;
}

const { lang, t } = Astro.props;
---

<footer class="footer">
  <div class="container row">
    <Logo href={homePath(lang)} />
    <ul>
      <li>© 2026 Masadan</li>
      <li><a href={privacyPath(lang)}>{t.footer.privacy}</a></li>
      <li>{t.footer.region}</li>
    </ul>
    <LangToggle lang={lang} label={t.nav.languageLabel} />
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-divider);
    padding-block: 2rem;
    font-size: 0.875rem;
    color: var(--color-neutral-900);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    color: inherit;
  }
  a:hover {
    color: var(--color-text);
  }
</style>
