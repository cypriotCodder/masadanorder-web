---
import { whatsappUrl } from '../config';
import { homePath, sections, type Dictionary, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  t: Dictionary;
}

const { lang, t } = Astro.props;
---

<div class="mobile-bar">
  <a class="btn btn-secondary" href={whatsappUrl(t.cta.whatsappMessage)} rel="noopener">
    {t.cta.whatsapp}
  </a>
  <a class="btn btn-primary" href={`${homePath(lang)}#${sections.contact}`}>{t.cta.requestDemo}</a>
</div>

<style>
  .mobile-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    padding: 0.625rem 1rem calc(0.625rem + env(safe-area-inset-bottom));
    background: var(--color-bg);
    border-top: 1px solid var(--color-divider);
  }
  .mobile-bar .btn {
    justify-content: center;
  }
  @media (min-width: 768px) {
    .mobile-bar {
      display: none;
    }
  }
</style>
