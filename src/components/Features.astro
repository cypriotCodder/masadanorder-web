---
import { sections, type Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;

// Icon paths (24×24, stroked), in the same order as t.features.items.
const icons = [
  // Languages
  'M3 5h10M8 3v2m2.5 0c-.8 3.5-3.3 6.5-6.5 8m2-4.5c1.2 1.8 3 3.3 5 4.2M13 21l4.5-10L22 21m-7.5-3h6',
  // Printer
  'M6 9V3h12v6M6 18H4a1 1 0 0 1-1-1v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6a1 1 0 0 1-1 1h-2M7 14h10v7H7z',
  // Screen
  'M3 4h18v12H3zM8 20h8M12 16v4M7 8h4m-4 4h7',
  // Edit
  'M4 20h4L19 9l-4-4L4 16v4zM13.5 6.5l4 4',
  // Pin
  'M12 21s7-6.1 7-11.5a7 7 0 1 0-14 0C5 14.9 12 21 12 21zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  // QR
  'M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h2v2h-2zM18 14h2M14 18h2v2M18 18h2v2h-2',
];
---

<section id={sections.features} class="section features" aria-labelledby="features-title">
  <div class="container">
    <h2 id="features-title" class="section-title">{t.features.title}</h2>
    <ul class="grid">
      {
        t.features.items.map((item, i) => (
          <li>
            <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
              <path d={icons[i]} />
            </svg>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features {
    background: var(--color-neutral-100);
  }
  .grid {
    display: grid;
    gap: 2rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  svg {
    margin-bottom: 0.75rem;
    padding: 0.5rem;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.75rem;
    background: var(--color-accent-100);
    fill: none;
    stroke: var(--color-accent-700);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  h3 {
    margin: 0 0 0.375rem;
    font-size: 1.125rem;
  }
  p {
    margin: 0;
    line-height: 1.5;
    color: var(--color-neutral-900);
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
