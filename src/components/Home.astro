---
// The landing page body, shared by both locales so their structure can't drift.
import Hero from './Hero.astro';
import Problem from './Problem.astro';
import HowItWorks from './HowItWorks.astro';
import Features from './Features.astro';
import Proof from './Proof.astro';
import DemoBand from './DemoBand.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import { getDictionary, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<main>
  <Hero lang={lang} t={t} />
  <Problem t={t} />
  <HowItWorks t={t} />
  <Features t={t} />
  <Proof t={t} />
  <DemoBand t={t} />
  <Faq t={t} />
  <Contact t={t} />
</main>
