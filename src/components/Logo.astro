---
// Icon + wordmark text until the app has an SVG wordmark (see plan.md → Placeholders).
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a class="logo" href={href}>
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
    <rect width="32" height="32" rx="7" fill="var(--color-text)"></rect>
    <circle cx="16" cy="16" r="7" fill="var(--color-accent)"></circle>
  </svg>
  <span>Masadan</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    font-weight: 700;
    font-size: 1.125rem;
    text-decoration: none;
    flex-shrink: 0;
  }
</style>
