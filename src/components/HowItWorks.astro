---
import { sections, type Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section id={sections.howItWorks} class="section" aria-labelledby="how-title">
  <div class="container">
    <h2 id="how-title" class="section-title">{t.how.title}</h2>
    <ol class="steps">
      {
        t.how.steps.map((step, i) => (
          <li>
            <span class="num" aria-hidden="true">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
    <!-- Slot for the 10–15 s ordering-flow loop (plan.md → Phase 5). -->
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    padding: 1.5rem;
    border-radius: 1rem;
    background: #fff;
    border: 1px solid var(--color-divider);
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 1rem;
    border-radius: 50%;
    background: var(--color-accent);
    font-weight: 700;
  }
  h3 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }
  p {
    margin: 0;
    line-height: 1.5;
    color: var(--color-neutral-900);
  }
  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
</style>
