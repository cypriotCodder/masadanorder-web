---
import { DEMO_URL } from '../config';
import type { Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section class="band" aria-labelledby="demo-title">
  <div class="container inner">
    <div>
      <h2 id="demo-title" class="visually-hidden">{t.demoBand.title}</h2>
      <p>{t.demoBand.text}</p>
    </div>
    <a class="btn btn-dark" href={DEMO_URL} rel="noopener">{t.cta.tryDemo} →</a>
  </div>
</section>

<style>
  .band {
    padding-block: 3rem;
    background: var(--color-accent);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
  }
  p {
    margin: 0;
    max-width: 40rem;
    font-size: clamp(1.25rem, 3.5vw, 1.625rem);
    font-weight: 600;
    line-height: 1.3;
  }
  .btn-dark {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .btn-dark:hover {
    background: #000;
  }
</style>
